# Base de données PostgreSQL (en ligne : créée automatiquement par Vercel > Storage > Neon)
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/pharma"
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@hote:5432/pharma"

# Adresse publique du site (sert aux liens de suivi envoyés aux clients)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret de signature des sessions, des codes de retrait et des empreintes : longue chaîne aléatoire (64 caractères minimum)
AUTH_SECRET="change-moi-par-une-longue-chaine-aleatoire-de-64-caracteres-minimum"

# Devise affichée et fuseau horaire des horaires d'ouverture
CURRENCY="XAF"
TIMEZONE="Africa/Brazzaville"

# --- Notifications (facultatif) ---
# Sans fournisseur configuré, les messages sont enregistrés en mode « simulé » et restent
# visibles par le client sur son lien de suivi sécurisé.
# E-mails via Resend.com
# RESEND_API_KEY=""
# MAIL_FROM="Pharma AI Connect <no-reply@votre-domaine.com>"
# SMS et WhatsApp via Twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_SMS_FROM="+242..."
# TWILIO_WHATSAPP_FROM="whatsapp:+242..."

# --- Paiement en ligne ---
# "sandbox" : paiement Mobile Money / carte simulé (tests). Laisser vide pour n'accepter que le paiement à la remise.
PAYMENT_PROVIDER="sandbox"

# Compte pharmacie de démonstration créé au premier déploiement (mot de passe commun aux comptes de démo)
DEMO_PHARMACY_PASSWORD="ChangeMoi!2026"
