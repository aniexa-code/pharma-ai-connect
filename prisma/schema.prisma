// Pharma AI Connect — schéma de données (V1.1)
// PostgreSQL (Neon via Vercel, Supabase ou toute base Postgres).
// DATABASE_URL = connexion poolée ; DATABASE_URL_UNPOOLED = connexion directe (schéma).
//
// Règle V1.1 : rien dans ce schéma n'exige un compte client. Les commandes, demandes et
// notifications existent seules ; le lien vers un compte (customerId) est toujours facultatif.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Référentiel ----------

/// Pays ouverts sur la plateforme : devise, fuseau horaire et règles locales.
/// Toutes les règles financières et de recherche sont dans Setting, jamais dans le code.
model Country {
  code           String   @id // ISO 3166-1 alpha-2 : BJ, CG...
  name           String
  currency       String // XOF, XAF...
  timezone       String // Africa/Porto-Novo...
  dialCode       String // +229
  defaultCity    String
  /// Moyens de paiement des gains (livreurs, pharmacies) : MOBILE_MONEY, MOOV_MONEY...
  payoutMethods  String[]
  /// Champs réglementaires demandés à l'inscription d'une pharmacie : [{ key, label, required, hint }]
  pharmacyFields Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Zone {
  id      String @id @default(cuid())
  name    String // quartier ou arrondissement
  city    String
  country String @default("BJ")
  lat     Float
  lng     Float

  @@unique([name, city])
}

/// Réglages modifiables depuis l'administration. key = "global" ou code pays ; value = réglages partiels
/// fusionnés avec les valeurs par défaut de src/lib/settings.ts.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Journal d'audit : toute action sensible (réglage, validation, suspension, paiement...) y laisse une trace.
model AuditLog {
  id        String   @id @default(cuid())
  actorType String // ADMIN, PHARMACY, COURIER, CUSTOMER, SYSTEM
  actorId   String?
  action    String // ex. SETTINGS_UPDATED, PHARMACY_VERIFIED
  entity    String // ex. Setting:BJ, Pharmacy:xxx
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Pharmacy {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  address            String
  district           String
  city               String
  country            String             @default("BJ")
  lat                Float
  lng                Float
  phone              String
  whatsapp           String?
  email              String?
  /// Horaires hebdomadaires : { "1": [["08:00","20:00"]], ... } (0 = dimanche)
  openingHours       Json
  /// Date à laquelle la pharmacie a confirmé ses horaires : trop ancienne, le statut « ouvert » n'est plus affiché.
  hoursConfirmedAt   DateTime?
  onDuty             Boolean            @default(false) // pharmacie de garde
  /// Fin de la garde déclarée : sans date ou date passée, la pharmacie n'est pas présentée comme de garde.
  onDutyUntil        DateTime?
  offersPickup       Boolean            @default(true)
  offersDelivery     Boolean            @default(false)
  deliveryFee        Int                @default(0)
  deliveryRadiusKm   Float              @default(5)
  /// Moyens de paiement acceptés (codes PaymentMethod)
  paymentMethods     String[]           @default(["CASH"])
  active             Boolean            @default(true)
  /// Vérification humaine du dossier. Les pharmacies existantes restent validées ; une inscription démarre en PENDING.
  verificationStatus VerificationStatus @default(APPROVED)
  verificationNote   String?
  verifiedAt         DateTime?
  submittedAt        DateTime?
  licenseNumber      String?
  ownerName          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  stocks       Stock[]
  staff        PharmacyUser[]
  requests     PharmacyRequest[]
  orders       Order[]
  favoritedBy  FavoritePharmacy[]
  stockImports StockImport[]
}

enum Regulation {
  OTC // vente libre : commande en ligne directe
  PRESCRIPTION // ordonnance : validation du pharmacien avant paiement, ordonnance vérifiée à la remise
  RESTRICTED // non commandable en ligne : vérification et échange uniquement
}

model Product {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  dci        String // dénomination commune (molécule)
  form       String // comprimé, sirop...
  strength   String?
  category   String
  regulation Regulation @default(OTC)
  packaging  String? // conditionnement de référence (ex. « Boîte de 16 comprimés »)
  createdAt  DateTime   @default(now())

  stocks      Stock[]
  favoritedBy FavoriteProduct[]
}

enum StockStatus {
  AVAILABLE
  LOW
  OUT
  UNKNOWN
}

enum StockSource {
  PHARMACY // déclaré ou confirmé par la pharmacie
  IMPORT // import automatique d'un logiciel de gestion
  ESTIMATE // estimation de la plateforme
}

model Stock {
  id          String      @id @default(cuid())
  pharmacyId  String
  productId   String
  price       Int // prix unitaire, en unités de la devise (pas de centimes)
  quantity    Int? // quantité en stock, si la pharmacie choisit de la renseigner
  status      StockStatus @default(UNKNOWN)
  source      StockSource @default(ESTIMATE)
  packaging   String? // conditionnement propre à la pharmacie, s'il diffère de la référence
  confirmedAt DateTime?
  updatedAt   DateTime    @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, productId])
  @@index([productId])
}

model PharmacyUser {
  id           String   @id @default(cuid())
  pharmacyId   String
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
}

// Livreurs : voient les missions de livraison, l'adresse complète seulement après acceptation.
model Courier {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  phone              String
  passwordHash       String
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  /// Un livreur ne reçoit aucune mission tant que son dossier n'est pas validé par un administrateur.
  verificationStatus VerificationStatus @default(APPROVED)
  verificationNote   String?
  verifiedAt         DateTime?
  submittedAt        DateTime?
  city               String?
  zone               String?
  vehicle            String?
  idNumber           String?

  orders Order[]
}

enum VerificationStatus {
  PENDING // dossier reçu, en attente d'examen
  NEEDS_INFO // pièce manquante ou illisible : le demandeur complète
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentOwner {
  PHARMACY
  COURIER
}

/// Pièces justificatives, conservées en base (jamais publiques) et consultables par l'administration seulement.
model VerificationDocument {
  id        String        @id @default(cuid())
  ownerType DocumentOwner
  ownerId   String
  kind      String
  filename  String
  mime      String
  size      Int
  sha256    String
  data      Bytes
  createdAt DateTime      @default(now())

  @@index([ownerType, ownerId])
}

// ---------- Comptes clients (facultatifs) ----------

model Customer {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  phone          String?
  passwordHash   String
  /// Canal préféré pour les notifications : SMS, WHATSAPP, EMAIL
  notifyChannel  String   @default("EMAIL")
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders             Order[]
  requests           PharmacyRequest[]
  addresses          Address[]
  favoritePharmacies FavoritePharmacy[]
  favoriteProducts   FavoriteProduct[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  label      String
  line       String
  district   String?
  city       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model FavoritePharmacy {
  customerId String
  pharmacyId String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([customerId, pharmacyId])
}

model FavoriteProduct {
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
}

// ---------- Demandes de vérification et échanges (sans compte) ----------

enum RequestKind {
  VERIFICATION // « ce produit est-il disponible ? »
  QUESTION // simple échange avec la pharmacie
}

enum RequestStatus {
  PENDING
  CONFIRMED // disponible
  UNAVAILABLE
  ANSWERED // question traitée
  CLOSED
}

model PharmacyRequest {
  id            String        @id @default(cuid())
  publicRef     String        @unique // ex. VER-7KQ2-M9XD : affiché, mais ne donne accès à rien seul
  tokenHash     String        @unique // SHA-256 du jeton du lien sécurisé
  kind          RequestKind
  status        RequestStatus @default(PENDING)
  pharmacyId    String
  productId     String?
  quantity      Int           @default(1)
  contactName   String
  notifyChannel String // SMS, WHATSAPP, EMAIL ou LINK (lien seul)
  phone         String?
  email         String?
  customerId    String?
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pharmacy      Pharmacy       @relation(fields: [pharmacyId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages      Message[]
  notifications Notification[]

  @@index([pharmacyId, status])
}

model Message {
  id        String   @id @default(cuid())
  requestId String?
  orderId   String?
  author    String // CUSTOMER ou PHARMACY
  body      String
  createdAt DateTime @default(now())

  request PharmacyRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order   Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------- Commandes (invitées ou rattachées) ----------

enum OrderStatus {
  PRESCRIPTION_REVIEW // produit sur ordonnance : attente de validation du pharmacien
  AWAITING_PAYMENT // paiement en ligne attendu
  PLACED // transmise : la pharmacie vérifie physiquement la disponibilité
  AWAITING_CUSTOMER // vérifiée par la pharmacie : le client doit confirmer (retrait ou livraison)
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COURIER_ASSIGNED
  PICKED_UP // récupérée par le livreur
  OUT_FOR_DELIVERY
  DELIVERED
  COLLECTED // retirée en pharmacie
  CANCELLED
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

/**
 * Réponse de la pharmacie après vérification physique d'un produit commandé.
 */
enum ItemAnswer {
  AVAILABLE
  INSUFFICIENT // quantité insuffisante : confirmedQty indique ce qui est disponible
  UNAVAILABLE
  NEEDS_PHARMACIST // nécessite une validation du pharmacien au comptoir
  OTHER // autre précision (answerNote)
}

/**
 * Modes de remise autorisés par la pharmacie pour une commande vérifiée.
 */
enum FulfillmentMode {
  PICKUP_ONLY
  DELIVERY_ONLY
  BOTH
}

model Order {
  id                    String           @id @default(cuid()) // identifiant interne
  publicRef             String           @unique // référence publique non prévisible
  status                OrderStatus
  pharmacyId            String
  customerId            String? // rattachement facultatif à un compte
  fulfillment           Fulfillment
  slot                  String // créneau de retrait ou de livraison
  contactName           String
  phone                 String
  email                 String?
  notifyChannel         String // SMS, WHATSAPP, EMAIL ou LINK
  deliveryAddress       String?
  deliveryNotes         String?
  courierName           String?
  courierId             String?
  missionNo             Int              @unique @default(autoincrement()) // numéro de mission livreur, ex. PA-2048
  requiresPrescription  Boolean          @default(false)
  prescriptionCheckedAt DateTime?
  subtotal              Int
  deliveryFee           Int              @default(0)
  total                 Int
  currency              String
  /// Lien de suivi : seul le hachage SHA-256 du jeton est stocké.
  trackingTokenHash     String           @unique
  trackingExpiresAt     DateTime
  trackingRevokedAt     DateTime?
  /// Code de retrait : dérivé par HMAC(secret, id:nonce), jamais stocké en clair, à usage unique.
  handoverNonce         String
  /// Jeton de suivi dérivé par HMAC(secret, nonce) : recalculable pour les notifications, jamais stocké.
  trackingNonce         String?
  /// Vérification physique par la pharmacie, puis autorisation explicite du client.
  verifiedAt            DateTime?
  verifiedById          String?
  allowedModes          FulfillmentMode?
  customerConfirmedAt   DateTime?
  paymentPreference     String?
  /// Panier validé en une fois : une commande par pharmacie, regroupées.
  checkoutId            String?
  /// Clôture obligatoire par chaque partie : pharmacie, livreur (s'il y en a un) et client.
  pharmacyClosedAt      DateTime?
  courierClosedAt       DateTime?
  customerClosedAt      DateTime?
  closedAt              DateTime?
  customerIssue         String?
  /// Moteur de frais (étape 6) : montants figés à la confirmation du client, d'après les réglages du moment.
  serviceFee            Int              @default(0)
  deliveryDistanceKm    Float?
  deliveryCommission    Int              @default(0)
  courierEarning        Int              @default(0)
  feeBreakdown          Json?
  handoverCodeUsedAt    DateTime?
  handoverAttempts      Int              @default(0)
  requestId             String? // demande de vérification à l'origine de la commande
  clientIpHash          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  pharmacy      Pharmacy           @relation(fields: [pharmacyId], references: [id])
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  courier       Courier?           @relation(fields: [courierId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  events        OrderEvent[]
  payments      Payment[]
  messages      Message[]
  notifications Notification[]
  codes         VerificationCode[]

  @@index([pharmacyId, status])
  @@index([customerId])
  @@index([checkoutId])
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  unitPrice    Int
  quantity     Int
  regulation   Regulation
  answer       ItemAnswer?
  confirmedQty Int?
  answerNote   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  actor     String // CUSTOMER, PHARMACY, SYSTEM, PAYMENT
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      String // CASH, MOBILE_MONEY, CARD
  provider    String // cash, sandbox, ...
  providerRef String?
  amount      Int
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------- Notifications ----------

model Notification {
  id        String   @id @default(cuid())
  orderId   String?
  requestId String?
  channel   String // SMS, WHATSAPP, EMAIL, LINK
  recipient String? // coordonnée utilisée (absente pour LINK)
  event     String // ORDER_CONFIRMED, PAYMENT_CONFIRMED, READY_FOR_PICKUP...
  body      String
  status    String // SENT, SIMULATED, FAILED, LINK_ONLY
  error     String?
  createdAt DateTime @default(now())

  order   Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  request PharmacyRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ---------- Codes à usage limité (récupération du suivi, rattachement) ----------

model VerificationCode {
  id        String    @id @default(cuid())
  orderId   String
  purpose   String // RECOVER_TRACKING, CLAIM_ORDER
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, purpose])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum StockImportStatus {
  PENDING // rapport de validation affiché, en attente de confirmation
  PUBLISHED
  CANCELLED
}

/**
 * Import de stock (CSV / Excel) : rien n'est publié avant la confirmation de la pharmacie.
 */
model StockImport {
  id          String            @id @default(cuid())
  pharmacyId  String
  userId      String
  fileName    String
  status      StockImportStatus @default(PENDING)
  report      Json // lignes analysées et leur verdict
  summary     Json // décompte par catégorie
  createdAt   DateTime          @default(now())
  publishedAt DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
}

/**
 * Panier validé : une commande par pharmacie, suivies ensemble par un lien unique.
 */
model Checkout {
  id                String   @id @default(cuid())
  publicRef         String   @unique // ex. PAN-7KQ2-M9XD
  trackingTokenHash String   @unique
  trackingNonce     String
  contactName       String
  phone             String
  createdAt         DateTime @default(now())
}

// ---------- Finances ----------

/// Grand livre : une ligne n'est jamais modifiée ni supprimée (un déclencheur PostgreSQL l'interdit).
/// Une correction s'écrit comme une nouvelle ligne de sens inverse.
model LedgerEntry {
  id         String   @id @default(cuid())
  /// Clé d'unicité : la même opération ne peut pas être enregistrée deux fois.
  ref        String   @unique
  account    String // PLATFORM_SERVICE_FEE, PLATFORM_DELIVERY_COMMISSION, COURIER_EARNING, COURIER_PAYOUT, PHARMACY_SALES
  amount     Int // positif : crédit du compte ; négatif : débit
  currency   String
  orderId    String?
  courierId  String?
  pharmacyId String?
  payoutId   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([courierId, createdAt])
  @@index([account, createdAt])
  @@index([orderId])
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

model PayoutRequest {
  id          String       @id @default(cuid())
  courierId   String
  amount      Int
  currency    String
  method      String // MOBILE_MONEY, MOOV_MONEY
  phone       String
  status      PayoutStatus @default(REQUESTED)
  providerRef String?
  note        String?
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([courierId, createdAt])
  @@index([status])
}
